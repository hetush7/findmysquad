# Production settings. Copy to .env.prod and replace every value; never commit .env.prod.

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=0
# Your domain(s), comma separated
DJANGO_ALLOWED_HOSTS=findmysquad.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://findmysquad.example.com
# 1 when users reach the site over HTTPS (e.g. behind a load balancer with a certificate)
DJANGO_HTTPS=1

POSTGRES_DB=findmysquad
POSTGRES_USER=findmysquad
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Discord (optional). Create an app at https://discord.com/developers/applications,
# add the redirect URI below under OAuth2, and copy the client ID and secret.
# Leave empty to hide "Continue with Discord".
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://findmysquad.example.com/discord-callback
# Optional: a channel webhook (Channel settings > Integrations > Webhooks) to announce new rooms
DISCORD_LFG_WEBHOOK_URL=
# Public address of the site, used in links posted to Discord
SITE_URL=https://findmysquad.example.com

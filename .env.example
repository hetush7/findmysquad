# Copy to .env (start.sh does this automatically) and adjust as needed.
# Never commit the real .env file.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=0.0.0.0,localhost,127.0.0.1,web

POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

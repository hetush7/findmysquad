# Copy to .env (start.sh does this automatically) and adjust as needed.
# Never commit the real .env file.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=0.0.0.0,localhost,127.0.0.1,web

POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Where the React app sends API requests (the Django server as seen from the browser)
REACT_APP_API_URL=http://localhost:8000

# Discord (optional). Create an app at https://discord.com/developers/applications,
# add the redirect URI below under OAuth2, and copy the client ID and secret.
# Leave empty to hide "Continue with Discord".
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/discord-callback
# Optional: a channel webhook (Channel settings > Integrations > Webhooks) to announce new rooms
DISCORD_LFG_WEBHOOK_URL=
# Public address of the site, used in links posted to Discord
SITE_URL=http://localhost:3000
